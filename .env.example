# Copiar como .env para cambiar parámetros del simulador sin tocar docker-compose.yml.

# Semilla: con la misma semilla, el flujo continuo genera exactamente la misma corrida.
SIM_SEMILLA=42
# 120 → 1 hora simulada = 30 segundos reales
SIM_FACTOR=120
# Envíos por minuto real
SIM_ENVIOS_POR_MINUTO=20
# 0 = flujo sin fin. Un número fija una corrida finita (útil para verificar la analítica).
SIM_MAX_ENVIOS=0
# Historia que se genera al arrancar por primera vez (horas simuladas)
SIM_PRECARGA_HORAS=48
